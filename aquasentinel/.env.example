# ── Gemini(Vertex AI) 모드 ─────────────────────────────
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
ADK_MODEL_NAME=gemini-2.5-flash

# ── 오프라인 결정론 모드 (API 키 없이 전체 파이프라인 실행·테스트) ──
# AQUA_OFFLINE=1

# ── MCP 서버 연결 ──────────────────────────────────────
# 비워두면 mcp_server/server.py 를 stdio 자식 프로세스로 자동 실행
# Cloud Run 등에 HTTP 로 띄운 경우: AQUA_MCP_URL=https://<service>.run.app/mcp
AQUA_MCP_URL=
